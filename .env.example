# Copy to .env (never commit .env). Only used by the command-line tool;
# the web page asks for these values in its settings panel instead.

# "openai" = any OpenAI-compatible server (OpenAI, OpenRouter, Open WebUI, Ollama, vLLM, LM Studio...)
# "anthropic" = Claude API
LLM_PROVIDER=openai

# Everything before /chat/completions. Examples:
#   OpenAI      https://api.openai.com/v1
#   OpenRouter  https://openrouter.ai/api/v1
#   Open WebUI  https://your-server/api
#   Ollama      http://localhost:11434/v1
# For provider "anthropic" you can leave it empty (https://api.anthropic.com).
LLM_BASE_URL=https://api.openai.com/v1

LLM_API_KEY=
LLM_MODEL=

# Request timeout in seconds
# LLM_TIMEOUT=600

# The old OPENWEBUI_URL / OPENWEBUI_API_KEY / OPENWEBUI_MODEL variables still work.
